# pulsars-api configuration. Copy to .env for local development:
#   cp .env.example .env
# Every variable is read at startup; the service refuses to start and lists
# every problem when a required value is missing or invalid. The production
# file, with every variable, is deploy/pulsars-api.env.example
# (docs/deployment.md).

# Required. `development` or `production`. Production refuses http:// URLs
# and CORS origins, and requires MESSAGES_KEY and the signing key.
PULSARS_ENV=development

# Required. PostgreSQL, connecting as the `pulsars_api` role, which reads and
# writes rows and changes no structure (deploy/sql/roles.sql). Development
# value from scripts/dev-db-init.sh.
DATABASE_URL=postgres://pulsars_api:pulsars_api_dev@localhost:5432/pulsars
# Read by `pulsars-api migrate` only, never by the service. In production it
# lives in /etc/pulsars-api/migrate.env.
DATABASE_MIGRATION_URL=postgres://pulsars_migrate:pulsars_migrate_dev@localhost:5432/pulsars

# Pool size (1-200). Default 10.
# DATABASE_MAX_CONNECTIONS=10

# Required. Redis (redis:// or rediss://).
REDIS_URL=redis://localhost:6379

# The key game tokens are signed and verified with (docs/contract/auth-jwt.md).
# Required in production; unset here, POST /v1/auth/token and the routes that
# need a game token answer 503. Make one with
#   cargo run -- jwt-keygen 2026-10-ed25519-1 .
# JWT_SIGNING_KEY_FILE=./2026-10-ed25519-1.key
# JWT_SIGNING_KID=2026-10-ed25519-1
# Lifetime of game tokens, 60 to 3600 seconds. Default 300.
# JWT_TOKEN_TTL_SECS=300

# The AES-256-GCM key of private messages: 32 random bytes in base64
# (openssl rand -base64 32). Required in production; unset here, the
# /v1/conversations routes answer 503.
# MESSAGES_KEY=
# MESSAGES_KEY_VERSION=1

# The site's key (Pulsars-Service-Key), at least 32 characters: its calls
# are not rate limited, and the service-key routes accept them. Unset:
# nothing is exempt, and those routes answer 403.
# SERVICE_KEY=

# Public base URL of the `public` files (avatars, suggestion images): the
# site's /storage, which relays to GET /v1/storage/{path}. Default
# https://pulsars.science/storage.
# PUBLIC_STORAGE_URL=http://localhost:3000/storage

# Public HTTP listener. Default 127.0.0.1:8080 (behind the edge proxy).
# BIND_ADDR=127.0.0.1:8080

# Prometheus /metrics listener. Must be a loopback or private address and a
# different port from BIND_ADDR. Default 127.0.0.1:9464 (9100 is left to the
# node exporter).
# METRICS_ADDR=127.0.0.1:9464

# Origins allowed to ask for a game token, to call the token endpoints with
# credentials and to open the game WebSocket, comma-separated. Default:
# https://pulsars.science, plus http://localhost:5173 in development.
# Public content endpoints allow any origin regardless.
# CORS_ALLOWED_ORIGINS=https://pulsars.science,http://localhost:5173

# Rate limits, in requests per minute: per client IP for anonymous calls,
# per token `sub` for calls with a valid game token. Defaults 60 and 120
# (docs/contract/README.md). Counted in Redis; while Redis is down, requests
# are not limited.
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
# RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# Per-request timeout in seconds (1-120). Default 10.
# REQUEST_TIMEOUT_SECS=10

# Maximum JSON request body in bytes (1024 to 10485760). Default 65536. The
# uploads have their own limits (docs/deployment.md).
# BODY_LIMIT_BYTES=65536

# Account mails. Unset: they are only logged, without their link. Mailpit:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# MAIL_SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=Pulsars <noreply@blackenium.com>

# DeepL: translation of forum posts and `pulsars-api content translate`.
# Unset key: the translation routes answer 503 `not_configured`.
# DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com
# DEEPL_LANGUAGES=fr=FR,en=EN-GB,ru=RU

# Umami, read by the admin dashboard: all four or none.
# UMAMI_URL=http://127.0.0.1:3001
# UMAMI_WEBSITE_ID=
# UMAMI_USERNAME=
# UMAMI_PASSWORD=

# Memory cost of the argon2id password hashes, in KiB. Default 19456 (OWASP).
# Lowered by the tests only.
# ARGON2_MEMORY_KIB=19456

# Logs: `json` (default) or `pretty`, and the tracing filter.
LOG_FORMAT=pretty
# RUST_LOG=info,sqlx=warn,tower_http=info

# Seconds given to in-flight requests after SIGTERM. Default 20.
# SHUTDOWN_GRACE_SECS=20
