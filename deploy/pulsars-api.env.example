# Production configuration of pulsars-api, read by systemd
# (EnvironmentFile= in pulsars-api.service). Install it as:
#
#   sudo install -d -m 0750 /etc/pulsars-api
#   sudo install -m 0600 pulsars-api.env.example /etc/pulsars-api/pulsars-api.env
#   sudoedit /etc/pulsars-api/pulsars-api.env
#
# root:root 0600: systemd reads it before dropping privileges, the service
# account never needs to. Every variable is described in .env.example at the
# root of the repository; the service refuses to start (exit 78) and lists
# every problem when a value is missing or invalid:
#   sudo journalctl -u pulsars-api -n 20
#
# systemd syntax: one KEY=value per line, no `export`, no spaces around `=`.
# Generate passwords with `openssl rand -hex 32`: hex needs no escaping in a
# URL.

PULSARS_ENV=production

# Role pulsars_api: reads and writes rows, changes no structure
# (deploy/sql/roles.sql, which sets its password).
DATABASE_URL=postgres://pulsars_api:CHANGE_ME@127.0.0.1:5432/pulsars
# Keep room for a second instance during maintenance.
DATABASE_MAX_CONNECTIONS=10

# Redis ACL user pulsars_api, limited to the pulsars-api:* keys.
REDIS_URL=redis://pulsars_api:CHANGE_ME@127.0.0.1:6379/0

# Laravel's public keys (Laravel tasks A3 and A9). Must answer before the API
# reports healthy.
JWKS_URL=https://pulsars.science/.well-known/jwks.json

# Defaults, written out so the running values are visible in one place.
JWT_ISSUER=https://pulsars.science
JWT_AUDIENCE=api.pulsars.science
PUBLIC_STORAGE_URL=https://pulsars.science/storage
# Also the origins allowed to open the game WebSocket. The game front end is
# served under https://pulsars.science/jeux/ (game-protocol.md): its origin
# is https://pulsars.science.
CORS_ALLOWED_ORIGINS=https://pulsars.science

# nginx proxies to BIND_ADDR. METRICS_ADDR must stay on loopback (or a
# private address): nginx never exposes it.
BIND_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9464

# Match results to Laravel (docs/contract/webhooks.md): Octane on the
# loopback, with the site's Host. The secret is GAME_WEBHOOK_SECRET in
# Laravel's environment (openssl rand -hex 32, at least 32 characters).
# Uncomment once Laravel has that secret; until then the results wait in
# game.webhook_outbox and are sent when these are set.
# LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/internal/jeu/evenements
# LARAVEL_WEBHOOK_SECRET=CHANGE_ME
# LARAVEL_WEBHOOK_HOST=pulsars.science

RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# The site reads content from this machine for all its visitors: its calls
# carry this key (Pulsars-Service-Key) and are not rate limited. The same
# value is PULSARS_API_SERVICE_KEY in Laravel's environment (openssl rand
# -hex 32, at least 32 characters). Unset: the site's calls share the
# loopback's 60 per minute and fall back to the database beyond.
# SERVICE_KEY=CHANGE_ME

# The key private messages are sealed with (AES-256-GCM, src/crypto.rs).
# Required in production: 32 random bytes in base64, generated once with
#   openssl rand -base64 32
# Losing it makes every stored private message unreadable; keep a copy with
# the database backups' secrets. MESSAGES_KEY_VERSION is stored with each
# message (default 1): raise it with a new key once rotation is supported.
MESSAGES_KEY=CHANGE_ME
# MESSAGES_KEY_VERSION=1

# The API's own key for game tokens (POST /v1/auth/token,
# docs/contract/auth-jwt.md §7). Generate it once:
#   sudo -u pulsars-api /opt/pulsars-api/current/pulsars-api jwt-keygen 2026-10-ed25519-1 /etc/pulsars-api
# The file must be mode 0600, owned by the service user. Unset: the
# endpoint answers 503 and games keep using the site's /jeu/jeton.
# JWT_SIGNING_KEY_FILE=/etc/pulsars-api/2026-10-ed25519-1.key
# JWT_SIGNING_KID=2026-10-ed25519-1
# JWT_TOKEN_TTL_SECS=300

# Account mails (verification, forgotten password; docs/contract/
# auth-sessions.md §4b): the same SMTP account as the site's docs/EMAIL.md.
# Unset: mails are only logged (never their link) and nobody receives them.
# MAIL_SMTP_URL=smtps://resend:CHANGE_ME@smtp.resend.com:465
# MAIL_FROM=Pulsars <noreply@blackenium.com>

# DeepL: translation of forum posts and `pulsars-api content translate`.
# Unset key: the translation routes answer 503 (not_configured) and the
# command refuses to run. The language map is the site's language,
# `=`, DeepL's target_lang.
# DEEPL_API_KEY=CHANGE_ME
# DEEPL_API_URL=https://api-free.deepl.com
# DEEPL_LANGUAGES=fr=FR,en=EN-GB,ru=RU

# The admin dashboard's audience (Umami), all four or none. Unset: the
# dashboard says it is not configured.
# UMAMI_URL=http://127.0.0.1:3001
# UMAMI_WEBSITE_ID=CHANGE_ME
# UMAMI_USERNAME=CHANGE_ME
# UMAMI_PASSWORD=CHANGE_ME

# Below nginx's proxy_read_timeout (30 s).
REQUEST_TIMEOUT_SECS=10
# Below nginx's client_max_body_size (256k).
BODY_LIMIT_BYTES=65536

LOG_FORMAT=json
RUST_LOG=info,sqlx=warn,tower_http=info

# Below TimeoutStopSec in pulsars-api.service (30 s).
SHUTDOWN_GRACE_SECS=20
