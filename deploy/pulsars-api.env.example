# Production configuration of pulsars-api, read by systemd
# (EnvironmentFile= in pulsars-api.service) and by `pulsars-api migrate`.
# Install it as:
#
#   sudo install -m 0600 -o root -g root pulsars-api.env.example /etc/pulsars-api/pulsars-api.env
#   sudoedit /etc/pulsars-api/pulsars-api.env
#
# root:root 0600: systemd reads it before dropping privileges, the service
# account never needs to. Every variable is listed below, with its default;
# docs/deployment.md §5 describes each. The service refuses to start (exit
# 78) and lists every problem when a value is missing or invalid:
#   sudo journalctl -u pulsars-api -n 20
#
# systemd syntax: one KEY=value per line, no `export`, no quotes needed, no
# spaces around `=`. Generate passwords with `openssl rand -hex 32`: hex
# needs no escaping in a URL. Replace every CHANGE_ME.

PULSARS_ENV=production

# ------------------------------------------------------------ required

# Role pulsars_api: reads and writes rows, changes no structure
# (deploy/sql/roles.sql sets its password).
DATABASE_URL=postgres://pulsars_api:CHANGE_ME@127.0.0.1:5432/pulsars
# Redis ACL user pulsars_api, limited to the pulsars-api:* keys.
REDIS_URL=redis://pulsars_api:CHANGE_ME@127.0.0.1:6379/0

# The key game tokens are signed and verified with
# (docs/contract/auth-jwt.md). Generate it once:
#   sudo -u pulsars-api /opt/pulsars-api/current/pulsars-api jwt-keygen 2026-10-ed25519-1 /etc/pulsars-api/keys
# The file must be mode 0600 (enforced) and readable by the service user.
JWT_SIGNING_KEY_FILE=/etc/pulsars-api/keys/2026-10-ed25519-1.key
JWT_SIGNING_KID=2026-10-ed25519-1

# The key private messages are sealed with (AES-256-GCM, src/crypto.rs): 32
# random bytes in base64, generated once with
#   openssl rand -base64 32
# Losing it makes every stored private message unreadable: keep a copy with
# the database backups' secrets. MESSAGES_KEY_VERSION is stored with each
# message: raise it with a new key once rotation is supported.
MESSAGES_KEY=CHANGE_ME
MESSAGES_KEY_VERSION=1

# pulsars-web's key: its calls carry it in Pulsars-Service-Key, are not rate
# limited, and may use the service-key routes. The same value is in
# pulsars-web's environment. At least 32 characters: openssl rand -hex 32.
# Optional for the API, but the site needs it.
SERVICE_KEY=CHANGE_ME

# ---------------------------------------------------- account mails (SMTP)

# Verification and forgotten-password mails. Unset: mails are only logged
# (never their link) and nobody receives them.
MAIL_SMTP_URL=smtps://resend:CHANGE_ME@smtp.resend.com:465
MAIL_FROM=Pulsars <noreply@blackenium.com>

# ----------------------------------------------------------------- DeepL

# Translation of forum posts and `pulsars-api content translate`. Unset key:
# the translation routes answer 503 (not_configured) and the command refuses
# to run. The language map is the site's language, `=`, DeepL's target_lang.
# https://api.deepl.com for a paid plan.
DEEPL_API_KEY=CHANGE_ME
DEEPL_API_URL=https://api-free.deepl.com
DEEPL_LANGUAGES=fr=FR,en=EN-GB,ru=RU

# ----------------------------------------------------------------- Umami

# The admin dashboard's audience, all four or none. Unset: the dashboard
# says it is not configured.
# UMAMI_URL=http://127.0.0.1:3001
# UMAMI_WEBSITE_ID=CHANGE_ME
# UMAMI_USERNAME=CHANGE_ME
# UMAMI_PASSWORD=CHANGE_ME

# The containers' health on the admin dashboard: the snapshot that
# pulsars-podman-releve writes every minute (deploy/podman/README.md),
# bind-mounted read-only into the API's container. Unset: the dashboard
# says it is not configured. The API never talks to Podman itself.
# PODMAN_SNAPSHOT_PATH=/run/pulsars-podman/releve.json

# ------------------------------------------------- defaults, written out

# Game tokens' lifetime, 60 to 3600 seconds.
JWT_TOKEN_TTL_SECS=300
# The site's /storage, which relays to GET /v1/storage/{path}: avatar URLs.
PUBLIC_STORAGE_URL=https://pulsars.science/storage
# Origins that may ask for a game token and open the game WebSocket. The
# games are served under https://pulsars.science/jeux/ and the languages
# section under /langues/: their origin is https://pulsars.science.
CORS_ALLOWED_ORIGINS=https://pulsars.science

# nginx and pulsars-web call BIND_ADDR. METRICS_ADDR must stay on loopback
# (or a private address): nginx never exposes it.
BIND_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9464

# Keep room for a second instance during maintenance.
DATABASE_MAX_CONNECTIONS=10

RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# Below nginx's proxy_read_timeout (30 s).
REQUEST_TIMEOUT_SECS=10
# JSON bodies. Below nginx's client_max_body_size (256k) on
# api.pulsars.science; the uploads have their own limits (21 MiB).
BODY_LIMIT_BYTES=65536

LOG_FORMAT=json
RUST_LOG=info,sqlx=warn,tower_http=info

# Below TimeoutStopSec in pulsars-api.service (30 s).
SHUTDOWN_GRACE_SECS=20

# Memory cost of the argon2id password hashes, in KiB (OWASP). Never lower
# it in production.
ARGON2_MEMORY_KIB=19456
