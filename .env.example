# pulsars-api configuration. Copy to .env for local development:
#   cp .env.example .env
# Every variable is read at startup; the service refuses to start and lists
# every problem when a required value is missing or invalid.

# Required. `development` or `production`. Production refuses http:// CORS
# origins.
PULSARS_ENV=development

# Required. PostgreSQL, connecting as the `pulsars_api` role, which reads and
# writes rows and changes no structure (deploy/sql/roles.sql). Development
# value from scripts/dev-db-init.sh.
DATABASE_URL=postgres://pulsars_api:pulsars_api_dev@localhost:5432/pulsars
# Read by `pulsars-api migrate` only, never by the service. In production it
# lives in /etc/pulsars-api/migrate.env (deploy/sql/roles.sql creates the
# role).
DATABASE_MIGRATION_URL=postgres://pulsars_migrate:pulsars_migrate_dev@localhost:5432/pulsars

# Pool size (1-200). Default 10.
# DATABASE_MAX_CONNECTIONS=10

# Required. Redis (redis:// or rediss://).
REDIS_URL=redis://localhost:6379

# Required. Laravel's public keys for game tokens (docs/contract/auth-jwt.md).
# HTTPS only in production; http is accepted in development for a local
# Laravel. Loaded at startup and refreshed every 10 minutes: until one key is
# loaded, /healthz answers 503 and authenticated endpoints answer 503.
JWKS_URL=http://localhost:8000/.well-known/jwks.json

# Expected `iss` and `aud` of game tokens. Defaults below; change them only
# to test against a token issuer other than production.
# JWT_ISSUER=https://pulsars.science
# JWT_AUDIENCE=api.pulsars.science

# Base URL of Laravel's `public` disk, used to build avatar URLs. Default
# https://pulsars.science/storage. HTTPS only in production.
# PUBLIC_STORAGE_URL=https://pulsars.science/storage

# Public HTTP listener. Default 127.0.0.1:8080 (behind the edge proxy).
# BIND_ADDR=127.0.0.1:8080

# Prometheus /metrics listener. Must be a loopback or private address and a
# different port from BIND_ADDR. Default 127.0.0.1:9464 (9100 is left to the
# node exporter).
# METRICS_ADDR=127.0.0.1:9464

# Origins allowed to call authenticated endpoints with credentials and to
# open the game WebSocket, comma-separated. Default: https://pulsars.science, plus
# http://localhost:5173 in development. Public content endpoints allow any
# origin regardless.
# CORS_ALLOWED_ORIGINS=https://pulsars.science

# Rate limits, in requests per minute: per client IP for anonymous calls,
# per token `sub` for calls with a valid game token. Defaults 60 and 120
# (docs/contract/README.md). Counted in Redis; while Redis is down, requests
# are not limited.
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
# RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# Per-request timeout in seconds (1-120). Default 10.
# REQUEST_TIMEOUT_SECS=10

# Maximum request body in bytes. Default 65536.
# BODY_LIMIT_BYTES=65536

# Match results to Laravel (docs/contract/webhooks.md). Both or neither:
# without them, results wait in game.webhook_outbox. The secret is
# GAME_WEBHOOK_SECRET on the Laravel side (at least 32 characters).
# LARAVEL_WEBHOOK_HOST sets the Host header when the URL is an address.
# LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/internal/jeu/evenements
# LARAVEL_WEBHOOK_SECRET=
# LARAVEL_WEBHOOK_HOST=pulsars.science

# Logs: `json` (default) or `pretty`, and the tracing filter.
LOG_FORMAT=pretty
# RUST_LOG=info,sqlx=warn,tower_http=info

# Seconds given to in-flight requests after SIGTERM. Default 20.
# SHUTDOWN_GRACE_SECS=20
